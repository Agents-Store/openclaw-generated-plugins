    "skills/bank-balances",
    "skills/bank-reports",
    "skills/bank-statements",
    "skills/bank-transactions",
    "skills/broadcast-pattern",
    "skills/budget-alerts",
    "skills/currency-rates",
    "skills/e-documents",
    "skills/encrypted-storage",
    "skills/examples",
    "skills/payments",
    "skills/report-export",
    "skills/salary-management",
    "skills/transaction-categorization"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
